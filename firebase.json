{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.*",
      "**/.*/**",
      "README.md",
      "**/node_modules/**",
      "src/**",
      "**/__pycache__/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(svg|png|jpg|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}